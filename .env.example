SUPABASE_URL=https://your-project.supabase.co
# Llave pública anónima (usada por el cliente web y peticiones de usuario con RLS)
SUPABASE_ANON_KEY=your-anon-key
# Llave de rol de servicio opcional (solo para administración/scripts de mantenimiento)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Retrocompatibilidad: si solo usas SUPABASE_KEY, se usará como valor por defecto
SUPABASE_KEY=your-anon-key

# Dominios permitidos para CORS separados por coma (en producción pon la URL de tu frontend)
CORS_ORIGINS=http://localhost:4200,https://finanzas.midominio.com,https://tu-app.vercel.app

# Google Gemini API Key (para escaneo inteligente de tickets y recibos OCR)
GEMINI_API_KEY=your_gemini_api_key_here
